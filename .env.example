# Copia este archivo como .env.local y completa los valores.
# Sin estas variables la app sigue funcionando igual, pero guardando solo en el navegador.
# NUNCA pongas aquí la secret key (sb_secret_...) ni la contraseña de la base de datos:
# esas solo sirven del lado del servidor y la clave publishable ya expone lo necesario.

# --- Autenticación con Microsoft (MSAL) ---
# Opcionales: la app ya trae valores por defecto en src/auth/authConfig.js.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# --- Backend en Supabase ---
# Project Settings > API Keys.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
