# Copia este archivo como .env.local y completa los valores.
# Sin estas variables la app sigue funcionando igual, pero guardando solo en el navegador.

# --- Autenticación (opcional, ya hay valores por defecto en src/auth/authConfig.js) ---
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# --- Backend en Excel Online (Microsoft Graph) ---
# Ubicación del archivo. Usa SITIO + ARCHIVO/RUTA para SharePoint o Teams,
# o solo ARCHIVO/RUTA para el OneDrive del usuario firmado.

# Sitio de SharePoint/Teams: "ctpmedica.sharepoint.com/sites/Logistica" o el id del sitio.
VITE_EXCEL_SITIO=

# Opción A: id del archivo en el drive (lo ves en la URL de Excel Online, el GUID largo).
VITE_EXCEL_ARCHIVO=

# Opción B: ruta del archivo dentro del drive (empieza con /).
# VITE_EXCEL_RUTA=/Documentos/Logistica-CTP.xlsx

# Hoja y tabla donde se escriben las solicitudes.
VITE_EXCEL_HOJA=Hoja1
VITE_EXCEL_TABLA=Solicitudes
