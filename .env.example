# Copia este archivo como .env.local y completa los valores.
# Los valores de producción ya vienen por defecto en el código, así que en la
# práctica solo hace falta VITE_API_URL=http://localhost:3000 para desarrollo.
# NUNCA pongas aquí la contraseña de la base de datos ni FIRMA_SECRET: esas solo
# sirven del lado del servidor (ver server/.env.example).

# --- Autenticación con Microsoft (MSAL) ---
# Opcionales: la app ya trae valores por defecto en src/auth/authConfig.js.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Scope con el que se pide el token para la API propia. Si lo dejas vacío se usa
# `api://<VITE_AZURE_CLIENT_ID>/access_as_user`, que es el valor por defecto.
VITE_API_SCOPE=

# --- ¿Pedir el token a la API propia o a Microsoft Graph? ---
# 0 (por defecto): se pide un token de Graph. El backend lo valida igual, porque
#   Graph está firmado por las claves del mismo tenant. Funciona sin tocar nada
#   en Entra ID.
# 1: se pide `access_as_user`, el scope propio. SOLO ponlo en 1 después de
#   publicar ese scope en Entra ID (docs/04-DESPLIEGUE-HOSTING.md, sección 6.2);
#   si no existe, Microsoft rechaza el login y hay que entrar dos veces.
VITE_USAR_SCOPE_API=0

# --- Backend propio (Node.js + MySQL en el hosting) ---
# Origen de la API, sin la barra final. En producción ya trae el valor correcto
# por defecto; solo cámbialo si el subdominio cambia.
#   producción: https://api.pedro-ctpmedica.com
#   local:      http://localhost:3000
VITE_API_URL=https://api.pedro-ctpmedica.com
