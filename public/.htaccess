# ============================================================================
# Logística CTP · Frontend estático
# Todo lo que no sea un archivo real de /assets se sirve como index.html para
# que React Router funcione al recargar (p. ej. en /conductor o /administrador).
#
# Este archivo se sube a public_html junto con el contenido de dist/.
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No reescribir archivos ni carpetas que existen de verdad.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # El resto (rutas de la SPA) → index.html
  RewriteRule ^ /index.html [L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caché larga para los assets con hash en el nombre (Vite los genera). El
# content-type real que envía el hosting es text/javascript, así que hay que
# declarar ambas formas: con solo application/javascript los .js quedaban sin
# cabecera de caché.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # index.html nunca se cachea: es quien apunta a los hashes nuevos.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# El frontend llama a la API en otro subdominio; si se sirve desde el mismo
# dominio, estas cabeceras evitan que se mezclen las cookies de sesión.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # version.json nunca se cachea: la app lo sondea para detectar una versión
  # nueva y el aviso de actualización debe llegar siempre fresco.
  <Files "version.json">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
  </Files>

  # index.html y el service worker NUNCA se cachean. Son quienes deciden qué
  # assets carga la app y qué estrategia de caché se aplica: si el navegador se
  # queda con una copia vieja, el equipo no sale de la versión anterior aunque
  # recargue. Se revalida siempre contra el servidor.
  <Files "index.html">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </Files>
  <Files "sw.js">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </Files>
</IfModule>
