# ============================================================================
# Backend Node.js + MySQL (Latinoamérica Hosting)
# Copiar a server/.env y completar. NUNCA subir este archivo a Git.
# En el hosting, estas mismas variables se configuran en cPanel > Setup Node.js App
# > Environment variables.
# ============================================================================

NODE_ENV=production

# --- MySQL (cPanel > Bases de datos MySQL) ---
# El usuario y la BD llevan el prefijo de la cuenta de cPanel. Aquí la cuenta es
# "pedroct1" y la base se creó como "logistica", así que ambos quedan:
#   pedroct1_logistica
# Cópialos tal cual de cPanel > Bases de datos MySQL, no los adivines.
DB_HOST=localhost
DB_PORT=3306
DB_USER=pedroct1_logistica
DB_PASSWORD=
DB_NAME=pedroct1_logistica
DB_POOL=10

# --- Sesión propia (OBLIGATORIA en producción) ---
# Secreto con el que la API firma y verifica el token de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATORIA: si falta en producción la API no arranca a propósito. Con un
# secreto fijo en el código, cualquiera que descargue el repositorio podría
# fabricar su propio token con el rol de superadmin.
# Usa un valor DISTINTO al de FIRMA_SECRET.
SESSION_SECRET=
# Vida del token de sesión, en SEGUNDOS (no en horas: 28800 = 8 horas, que es lo
# razonable para un turno de trabajo). Al expirar, el usuario tiene que volver a
# escribir su contraseña, así que sub mucho este valor no compensa.
SESSION_TTL=28800

# --- Archivos ---
# Secreto para firmar las URLs de evidencia. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Es OBLIGATORIO en producción: si falta, la API no arranca a propósito. En
# desarrollo se genera uno temporal para poder levantarla sin configurar nada.
FIRMA_SECRET=
FIRMA_TTL=86400
MAX_ARCHIVO_BYTES=10485760

# --- CORS ---
# Orígenes del FRONTEND, separados por coma (sin barra final). La API corre en
# https://api.pedro-ctpmedica.com y la app en https://pedro-ctpmedica.com.
# Déjalo vacío solo para depurar: aceptaría cualquier origen.
CORS_ORIGENES=https://pedro-ctpmedica.com

# --- Correo de avisos (OPCIONAL: sin esto la API arranca igual) ---
# Es lo que envía los dos avisos automáticos:
#   · mala calificación  → al solicitante, con las áreas internas en copia;
#   · Retenido por Cartera → al solicitante.
#
# Es opcional a propósito: un SMTP mal puesto NO puede dejar sin entregas a la
# operación, así que si falta algo la app arranca y solo avisa en el log. Los
# valores de abajo son los de cPanel con el buzón de la empresa.
#
# Puerto: 465 es SMTPS (conexión cifrada directa) y 587 es STARTTLS. Usa el que
# te dé el panel. MAIL_SECURE no hace falta definirlo: se deduce del puerto.
#
# MAIL_PASSWORD NO va aquí en el hosting: se escribe en Setup Node.js App >
# Environment variables y se queda solo en el servidor. Este archivo es público.
MAIL_HOST=mail.pedro-ctpmedica.com
MAIL_PORT=465
MAIL_USER=operaciones@pedro-ctpmedica.com
MAIL_PASSWORD=
# Remitente. Si el servidor de correo no autoriza tu dominio en SPF/DKIM, usa
# aquí una dirección del propio hosting (por ejemplo una creada en cPanel) o los
# mensajes van a parar en spam.
MAIL_FROM=operaciones@pedro-ctpmedica.com
MAIL_FROM_NAME=Logística CTP
# Casilla que recibe los avisos SIEMPRE. Es la que garantiza que el solicitante y
# la operación se enteren aunque alguna de las casillas de la copia todavía no
# exista en el hosting (una dirección inexistente hace que el servidor de correo
# rechace el mensaje entero). Déjalo vacío si es la misma que MAIL_USER.
MAIL_OPERATIVO=

# Destinatarios internos en copia, separados por coma. Si los dejas vacíos se
# usan los del código, que ya vienen con el dominio de este hosting
# (@pedro-ctpmedica.com); pon aquí los tuyos si algún día cambian.
#   CORREOS_ALERTA_CALIDAD=operaciones@pedro-ctpmedica.com,almacen@pedro-ctpmedica.com
#   CORREOS_REENCION_CARTERA=operaciones@pedro-ctpmedica.com
CORREOS_ALERTA_CALIDAD=
CORREOS_REENCION_CARTERA=
